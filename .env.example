# ==============================================================================
# SentinelSentry Environment Variables
#
# NOTE: No API key is needed to run the live demo or web dashboard!
# The multi-agent swarm, simulated RSS feeds, and Gemma 4 dispatch engine
# run 100% locally and offline out of the box with zero external dependencies.
# ==============================================================================

# 1. Hugging Face Token (Optional - only needed to push adapter weights to HF Hub)
# Get your token at: https://huggingface.co/settings/tokens (Write permission)
HF_TOKEN=hf_your_token_here

# 2. Google AI Studio / Gemini API Key (Optional - only needed for dataset generation scripts)
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# 3. Web Dashboard Server Port & Host (Optional)
WEB_DASHBOARD_HOST=127.0.0.1
WEB_DASHBOARD_PORT=8000

# 4. CARTO Map API Key & Tile URL (Optional - only needed for enterprise/private CARTO accounts)
# By default, CARTO's public DarkMatter tile CDN (basemaps.cartocdn.com) is used
# out of the box with zero keys, accounts, or payment required.
# CARTO_API_KEY=your_carto_api_key_here
# MAP_TILE_URL=https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png
